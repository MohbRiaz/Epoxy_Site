# Copy these into Vercel → Project → Settings → Environment Variables, then redeploy.
# Leave a group empty to keep that feature switched off.

# --- Required on Vercel so the Razorpay webhook can check its signature ---
NODEJS_HELPERS=0

# --- Razorpay online payments (test keys start with rzp_test_, live with rzp_live_) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Shiprocket (use an API user: Shiprocket → Settings → API → Create API user) ---
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_PINCODE=

# --- Odoo CRM (every form + order becomes a CRM lead) ---
ODOO_URL=https://yourcompany.odoo.com
ODOO_DB=yourcompany
ODOO_USER=you@theepoxystudio.in
ODOO_API_KEY=

# --- Optional: also send every lead to a webhook (Zapier, Make, Google Sheets) ---
LEAD_WEBHOOK_URL=
